APP_NAME="RBI Lending Intelligence Graph RAG"
APP_ENV=development
DATA_DIR=data
DATABASE_URL=postgresql://rag:rag@postgres:5432/rbi_rag
ADMIN_API_KEY=
MONITOR_SECRET=
VECTOR_BACKEND=filesystem
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_ANSWER_MODEL=gpt-4o-mini
EXTRACTION_PROVIDER=deterministic
ANSWER_PROVIDER=deterministic
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=900
CHUNK_SIZE=900
CHUNK_OVERLAP=150
VECTOR_TOP_K=5
LOG_LEVEL=INFO
