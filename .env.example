APP_NAME="RBI Lending Intelligence Graph RAG"
APP_ENV=development
DATA_DIR=data
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rbi_rag
VECTOR_BACKEND=filesystem
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_ANSWER_MODEL=gpt-4o-mini
EXTRACTION_PROVIDER=deterministic
CHUNK_SIZE=900
CHUNK_OVERLAP=150
VECTOR_TOP_K=5
LOG_LEVEL=INFO
